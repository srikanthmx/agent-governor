{
  "name": "@agent-governor/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "src/index.ts"
  },
  "scripts": {
    "agent": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-governor/config": "workspace:*",
    "@agent-governor/core": "workspace:*",
    "@agent-governor/db": "workspace:*",
    "@agent-governor/git": "workspace:*",
    "@agent-governor/github": "workspace:*",
    "@agent-governor/runtime": "workspace:*",
    "commander": "^12.1.0",
    "execa": "^9.3.0"
  }
}
